# Impresa Romanazzi Domenico — regole per server Apache
#
# Cache: le pagine HTML vanno sempre ricontrollate, così dopo un
# aggiornamento nessuno resta con la versione vecchia. CSS e JS possono
# restare in cache a lungo perché il loro indirizzo contiene una versione
# (style.css?v=...) che cambia da sola a ogni modifica.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Compressione dei file di testo
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

AddType video/mp4 .mp4

# Pagina d'errore del sito nuovo
ErrorDocument 404 /404.html

# Gli indirizzi del vecchio sito WordPress portano alle pagine nuove:
# chi arriva da Google o da un vecchio link non trova un errore, e il
# valore accumulato da quelle pagine passa alle nuove.
<IfModule mod_alias.c>
  Redirect 301 /chi-siamo/ /impresa.html
  Redirect 301 /chi-siamo /impresa.html
  Redirect 301 /contact/ /contatti.html
  Redirect 301 /contact /contatti.html
</IfModule>

# Un solo indirizzo per il sito (https e www), come indicato nei tag
# canonical. Attivare SOLO dopo aver verificato che il certificato HTTPS
# sia attivo sul dominio, togliendo i # dalle righe qui sotto.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off [OR]
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteRule ^ https://www.impresaromanazzidomenico.it%{REQUEST_URI} [L,R=301]
# </IfModule>
